local Kavo = loadstring(game:HttpGet("https://github.com/tomatotxt/Kavo-UI-Library/raw/refs/heads/main/source.lua"))()

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local CommF = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("CommF_")
local PlayerSpawns = workspace:WaitForChild("_WorldOrigin"):WaitForChild("PlayerSpawns")

-- Function to create and show the full-screen overlay
local function ShowFastTravelOverlay()
    if CoreGui:FindFirstChild("FastTravelOverlay") then
        CoreGui.FastTravelOverlay:Destroy()
    end

    local overlayGui = Instance.new("ScreenGui")
    overlayGui.Name = "FastTravelOverlay"
    overlayGui.IgnoreGuiInset = true
    overlayGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    overlayGui.Parent = CoreGui

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    bg.BackgroundTransparency = 0.4
    bg.BorderSizePixel = 0
    bg.Parent = overlayGui

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(0, 400, 0, 120)
    textLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    textLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 26
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.Text = "Fast Traveling...\n3.5s"
    textLabel.Parent = bg

    return overlayGui, textLabel
end

-- Fast Travel function with 3.5s countdown
local function FastTravel(TargetSpawn)
    local Start = os.clock()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local head = character:WaitForChild("Head")
    
    if humanoid.Health <= 0 then return false end

    -- 1. Show overlay and start countdown INSTANTLY on click (3.5s)
    local overlay, textLabel = ShowFastTravelOverlay()
    local active = true

    task.spawn(function()
        local timeLeft = 3.5
        while active and timeLeft > 0 do
            textLabel.Text = string.format("Fast Traveling...\n%.1fs", timeLeft)
            task.wait(0.1)
            timeLeft = timeLeft - 0.1
        end
        if active then
            textLabel.Text = "Respawning..."
        end
    end)

    -- 2. Handle network spawn point and character destruction
    CommF:InvokeServer("SetLastSpawnPoint", TargetSpawn)
    task.wait((LocalPlayer:GetNetworkPing() * 2) + (1/60))
    
    head:Destroy()
    task.wait()
    character:Destroy()
    
    -- 3. INSTANTLY remove overlay the exact millisecond the character respawns
    LocalPlayer.CharacterAdded:Wait()
    
    active = false
    if overlay then
        overlay:Destroy()
    end

    print("Successfully fast-traveled to: " .. tostring(TargetSpawn))
    print("Time taken: " .. tostring(os.clock() - Start) .. "s")
    return true
end

-- Force Respawn function using SetTeam2
local function ForceRespawn()
    local teamName = LocalPlayer.Team and LocalPlayer.Team.Name or "Pirates"
    print("Force respawning via SetTeam2 for team: " .. teamName)
    CommF:InvokeServer("SetTeam2", teamName)
end

-- Dynamic spawn list generator
local function GetSpawnList()
    local teamName = LocalPlayer.Team and LocalPlayer.Team.Name or "Pirates"
    local teamFolder = PlayerSpawns:FindFirstChild(teamName) or PlayerSpawns:FindFirstChild("Pirates")
    
    local names = {"Random"}
    if teamFolder then
        for _, spawnPart in ipairs(teamFolder:GetChildren()) do
            table.insert(names, spawnPart.Name)
        end
    end
    return names
end

-- ============================================================================
-- KAVO UI INTERFACE SETUP
-- ============================================================================
local Window = Kavo.CreateLib("Blox Fruits - Fast Travel GUI", "Ocean")

local MainTab = Window:NewTab("Fast Travel")

-- Section 1: Spawn Control
local TravelSection = MainTab:NewSection("Spawn Control")

local selectedSpawn = "Random"
local currentSpawnList = GetSpawnList()

-- Dropdown to choose target spawn
local spawnDropdown = TravelSection:NewDropdown("Select Spawn Point", "Choose a spawn point to travel to", currentSpawnList, function(selected)
    selectedSpawn = selected
end)

-- Button to execute Fast Travel
TravelSection:NewButton("Teleport to Spawn", "Fast-travels with 3.5s countdown overlay", function()
    local target = selectedSpawn
    
    if target == "Random" then
        local teamName = LocalPlayer.Team and LocalPlayer.Team.Name or "Pirates"
        local teamFolder = PlayerSpawns:FindFirstChild(teamName) or PlayerSpawns:FindFirstChild("Pirates")
        local spawns = teamFolder:GetChildren()
        
        if #spawns > 0 then
            target = spawns[math.random(1, #spawns)].Name
        else
            target = "Default"
        end
    end
    
    print("Targeting Spawn: " .. target)
    FastTravel(target)
end)

-- Button to Refresh Spawns
TravelSection:NewButton("Refresh Spawns", "Updates the spawn point list", function()
    currentSpawnList = GetSpawnList()
    spawnDropdown:Refresh(currentSpawnList)
    print("Spawn list refreshed!")
end)

-- Section 2: Extra Actions
local ExtraSection = MainTab:NewSection("Extra Actions")

-- Button for Force Respawn
ExtraSection:NewButton("Force Respawn", "Calls CommF with SetTeam2 to force respawn", function()
    ForceRespawn()
end)
