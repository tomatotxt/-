-- ========================================================================
-- [INTERNAL UTILITIES & CURRENT SEA RESOLVER]
-- ========================================================================
local function sanitize(str: string?): string
    if not str or type(str) ~= "string" then return "" end
    return str:lower():gsub("[^%a%d%s]", ""):gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
end

-- 3-Tier Multi-Method Current Sea Resolver
function FastTravelAPI.GetCurrentSea(): string
    -- 1. Try Map / Realm Modules
    local mapDefinitionsMod = ReplicatedStorage:FindFirstChild("Definitions") 
        and ReplicatedStorage.Definitions:FindFirstChild("Map")
    if mapDefinitionsMod then
        local success, Map = pcall(require, mapDefinitionsMod)
        if success and Map and Map.getCurrentMap then
            local curMap = Map.getCurrentMap()
            if curMap and curMap ~= "" then return curMap end
        end
    end

    local realmMod = ReplicatedStorage:FindFirstChild("Util") and ReplicatedStorage.Util:FindFirstChild("Realm")
    if realmMod then
        local success, Realm = pcall(require, realmMod)
        if success and Realm and Realm.getCurrentSeaAsync then
            local successSea, curSea = pcall(Realm.getCurrentSeaAsync)
            if successSea and curSea and curSea ~= "" then return curSea end
        end
    end

    -- 2. Try PlaceId Fingerprinting
    local placeId = game.PlaceId
    if placeId == 2753915549 then return "Sea1"
    elseif placeId == 4442272183 then return "Sea2"
    elseif placeId == 7449423635 then return "Sea3"
    end

    -- 3. Live Locations Fingerprinting in Workspace
    local locations = Workspace:FindFirstChild("_WorldOrigin") and Workspace._WorldOrigin:FindFirstChild("Locations")
    if locations then
        if locations:FindFirstChild("Fountain City") or locations:FindFirstChild("Middle Town") then
            return "Sea1"
        elseif locations:FindFirstChild("Kingdom of Rose") or locations:FindFirstChild("Green Zone") or locations:FindFirstChild("Graveyard") then
            return "Sea2"
        elseif locations:FindFirstChild("Floating Turtle") or locations:FindFirstChild("Tiki Outpost") or locations:FindFirstChild("Port Town") then
            return "Sea3"
        end
    end

    return "Sea1" -- Safe fallback
end

local function getCharacterComponents(): (Humanoid?, BasePart?, Model?)
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not hum or hum.Health <= 0 or not hrp then return nil, nil, nil end
    return hum, hrp, char
end

local function waitForLivingCharacter(): (Humanoid, BasePart, Model)
    while true do
        local hum, hrp, char = getCharacterComponents()
        if hum and hrp and char and char:IsDescendantOf(Workspace) then
            return hum, hrp, char
        end
        task.wait(0.1)
    end
end

local function QuadBezier(t: number, p0: Vector3, p1: Vector3, p2: Vector3): Vector3
    return (1 - t)^2 * p0 + 2 * (1 - t) * t * p1 + t^2 * p2
end

-- ========================================================================
-- [1. GET ISLANDS DATABASE (AUTO-DEFAULTS TO CURRENT SEA)]
-- ========================================================================
function FastTravelAPI.GetIslands(filterSea: string?): { [string]: IslandEntry }
    local currentSea = FastTravelAPI.GetCurrentSea()
    local targetSeaFilter = if filterSea and filterSea ~= "" then filterSea else currentSea
    local isShowAll = (sanitize(targetSeaFilter) == "all" or sanitize(targetSeaFilter) == "")

    local registry: { [string]: IslandEntry } = {}

    -- 1. Inter-Sea Gateways
    registry["first sea"] = {
        Id = "sea_1_hub",
        Name = "First Sea (Main World)",
        Key = "Main",
        Position = Vector3.new(1014, 16, 1463),
        LevelRequirement = 1,
        Sea = "Sea1",
        IsInterSea = true,
        RemoteAction = "TravelMain",
    }
    registry["second sea"] = {
        Id = "sea_2_hub",
        Name = "Second Sea (Dressrosa)",
        Key = "Dressrosa",
        Position = Vector3.new(-703, 10, 1575),
        LevelRequirement = 700,
        Sea = "Sea2",
        IsInterSea = true,
        RemoteAction = "TravelDressrosa",
    }
    registry["third sea"] = {
        Id = "sea_3_hub",
        Name = "Third Sea (Zou)",
        Key = "Zou",
        Position = Vector3.new(-5024, 1066, -2359),
        LevelRequirement = 1500,
        Sea = "Sea3",
        IsInterSea = true,
        RemoteAction = "TravelZou",
    }

    -- 2. Extract Static Definitions (Definitions.Map)
    local mapDefinitionsMod = ReplicatedStorage:FindFirstChild("Definitions") 
        and ReplicatedStorage.Definitions:FindFirstChild("Map")

    if mapDefinitionsMod then
        local success, Map = pcall(require, mapDefinitionsMod)
        if success and Map and Map.DEFINITIONS then
            for seaName, seaData in pairs(Map.DEFINITIONS) do
                if seaData.Islands then
                    for _, islandDef in ipairs(seaData.Islands) do
                        local islandName = (islandDef.Display and islandDef.Display[3]) 
                            or (islandDef.Index and islandDef.Index[1])
                        
                        local worldData = islandDef.World
                        local reqs = islandDef.Requirements or {}
                        local levelReq = 0

                        for _, req in ipairs(reqs) do
                            if req[2] == "Level" then
                                levelReq = req[1]
                                break
                            end
                        end

                        if islandName and worldData and worldData[2] then
                            local sName = sanitize(islandName)
                            local spawnKey = KNOWN_SPAWN_KEYS[sName] or islandName

                            registry[sName] = {
                                Id = islandDef.Index and islandDef.Index[1] or islandName,
                                Name = islandName,
                                Key = spawnKey,
                                Position = worldData[2],
                                LevelRequirement = levelReq,
                                Sea = seaName,
                                IsInterSea = false,
                            }
                        end
                    end
                end
            end
        end
    end

    -- 3. Live Workspace Fallback/Sync (_WorldOrigin.Locations)
    local locationsFolder = Workspace:FindFirstChild("_WorldOrigin") 
        and Workspace._WorldOrigin:FindFirstChild("Locations")

    if locationsFolder then
        for _, loc in ipairs(locationsFolder:GetChildren()) do
            if loc:IsA("BasePart") then
                local sName = sanitize(loc.Name)
                if not registry[sName] then
                    registry[sName] = {
                        Id = loc.Name,
                        Name = loc.Name,
                        Key = KNOWN_SPAWN_KEYS[sName] or loc.Name,
                        Position = loc.Position,
                        LevelRequirement = 0,
                        Sea = currentSea,
                        IsInterSea = false,
                    }
                else
                    registry[sName].Position = loc.Position
                end
            end
        end
    end

    -- Apply Filter (Defaults to Current Sea unless "all" is specified)
    if not isShowAll then
        local cleanFilter = sanitize(targetSeaFilter)
        local filtered: { [string]: IslandEntry } = {}
        for k, entry in pairs(registry) do
            -- Keep entry if sea matches OR if it's an inter-sea portal
            if sanitize(entry.Sea):find(cleanFilter, 1, true) or entry.IsInterSea then
                filtered[k] = entry
            end
        end
        return filtered
    end

    return registry
end

-- ========================================================================
-- [2. TRAVEL (SPAWN-RESET / INTER-SEA)]
-- ========================================================================
function FastTravelAPI.Travel(islandName: string?): boolean
    local cleanInput = sanitize(islandName)
    local islands = FastTravelAPI.GetIslands() -- Automatically scoped to current sea

    -- If empty: Print Directory Table for Current Sea
    if cleanInput == "" then
        local curSea = FastTravelAPI.GetCurrentSea()
        print("\n" .. string.rep("=", 80))
        print(string.format("             AVAILABLE FAST TRAVEL DESTINATIONS (%s)             ", curSea:upper()))
        print(string.rep("=", 80))
        print(string.format("%-28s | %-12s | %-8s | %s", "Island / Area Name", "Spawn Key", "Level", "Coordinates (X, Y, Z)"))
        print(string.rep("-", 80))

        local sortedList = {}
        for _, entry in pairs(islands) do table.insert(sortedList, entry) end
        table.sort(sortedList, function(a, b) return a.LevelRequirement < b.LevelRequirement end)

        for _, item in ipairs(sortedList) do
            local lvlStr = if item.LevelRequirement > 0 then string.format("Lvl %d+", item.LevelRequirement) else "None"
            local posStr = if item.IsInterSea then "Inter-Sea Gateway" 
                else string.format("(%.0f, %.0f, %.0f)", item.Position.X, item.Position.Y, item.Position.Z)
            
            print(string.format("%-28s | %-12s | %-8s | %s", item.Name, item.Key, lvlStr, posStr))
        end
        print(string.rep("=", 80) .. "\n")
        print("ℹ️ Usage: FastTravelAPI.Travel(\"<Island Name>\")")
        return false
    end

    -- Resolve Target
    local targetEntry: IslandEntry? = islands[cleanInput]
    if not targetEntry then
        for k, v in pairs(islands) do
            if k:find(cleanInput, 1, true) or sanitize(v.Name):find(cleanInput, 1, true) then
                targetEntry = v
                break
            end
        end
    end

    if not targetEntry then
        warn(string.format("[FastTravelAPI] Unknown destination '%s' in %s.", islandName or "", FastTravelAPI.GetCurrentSea()))
        return false
    end

    -- 1. Inter-Sea Travel
    if targetEntry.IsInterSea and targetEntry.RemoteAction then
        print(string.format("[FastTravelAPI] Transferring seas to: %s...", targetEntry.Name))
        local res = CommF:InvokeServer(targetEntry.RemoteAction)
        print(string.format("[FastTravelAPI] Server response: %s", tostring(res)))
        return true
    end

    -- 2. Local Spawn-Reset Travel
    print(string.format("[FastTravelAPI] Executing spawn travel to: %s (Key: %s)...", targetEntry.Name, targetEntry.Key))
    CommF:InvokeServer("SetLastSpawnPoint", targetEntry.Key)

    local hum, _, _ = getCharacterComponents()
    if hum then
        hum.Health = 0
        waitForLivingCharacter()
        print(string.format("[FastTravelAPI] Successfully arrived at %s!", targetEntry.Name))
        return true
    end

    return false
end

-- ========================================================================
-- [3. FAST TELEPORT (CLOSEST HUB + BEZIER JITTER FLIGHT)]
-- ========================================================================
function FastTravelAPI.FastTeleport(target: Vector3 | CFrame, cruiseSpeed: number?): boolean
    local speed = cruiseSpeed or 150 -- Default: 150 studs/sec
    local targetPos = if typeof(target) == "CFrame" then target.Position else target
    local targetCFrame = if typeof(target) == "CFrame" then target else CFrame.new(targetPos)

    -- Retrieve islands for the CURRENT SEA only
    local islands = FastTravelAPI.GetIslands()
    local hum, hrp, char = waitForLivingCharacter()

    local currentDistToTarget = (targetPos - hrp.Position).Magnitude

    -- Step 1: Find closest local island to the target position
    local closestIsland: IslandEntry? = nil
    local shortestDistToTarget = math.huge

    for _, island in pairs(islands) do
        if not island.IsInterSea then
            local dist = (island.Position - targetPos).Magnitude
            if dist < shortestDistToTarget then
                shortestDistToTarget = dist
                closestIsland = island
            end
        end
    end

    -- Step 2: Evaluate if Fast Travel Reset is needed
    if closestIsland and currentDistToTarget > 1500 and (shortestDistToTarget + 500) < currentDistToTarget then
        print(string.format("[FastTeleport] Nearest hub in %s is '%s' (%.0f studs from target). Resetting...", 
            FastTravelAPI.GetCurrentSea(), closestIsland.Name, shortestDistToTarget))
        
        FastTravelAPI.Travel(closestIsland.Key)
        hum, hrp, char = waitForLivingCharacter()
    end

    -- Step 3: Smooth Flight to Destination (150 st/s + Bezier + Jitter)
    local p0 = hrp.Position
    local p2 = targetPos
    local distance = (p2 - p0).Magnitude

    if distance <= 15 then
        hrp.CFrame = targetCFrame
        hrp.AssemblyLinearVelocity = Vector3.zero
        return true
    end

    print(string.format("[FastTeleport] Commencing Bezier flight (Dist: %.0f studs @ %.0f studs/sec)...", distance, speed))

    local midPoint = (p0 + p2) / 2
    local arcHeight = math.clamp(distance * 0.15, 30, 180)
    local p1 = midPoint + Vector3.new(0, arcHeight, 0)
    local curveLength = distance * 1.15
    local progress = 0
    local smoothRotation = CFrame.lookAt(p0, p2).Rotation
    local isTravelling = true

    local stepConnection
    stepConnection = RunService.Stepped:Connect(function(_, deltaTime)
        local curHum, curHrp, curChar = getCharacterComponents()
        if not isTravelling or not curHum or curHum.Health <= 0 or not curHrp or not curChar then
            isTravelling = false
            stepConnection:Disconnect()
            return
        end

        -- Continuous Noclip
        for _, part in ipairs(curChar:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end

        progress = math.min(progress + (speed * deltaTime) / curveLength, 1)

        -- Quadratic Bezier
        local bezierPos = QuadBezier(progress, p0, p1, p2)

        -- Dynamic Jitter (Dampens near target)
        local dampener = (1 - progress)
        local jitter = Vector3.new(
            (math.random() - 0.5) * 5 * dampener,
            (math.random() - 0.5) * 2.5 * dampener,
            (math.random() - 0.5) * 5 * dampener
        )

        curHrp.CFrame = CFrame.new(bezierPos + jitter) * smoothRotation
        curHrp.AssemblyLinearVelocity = Vector3.zero
        curHrp.AssemblyAngularVelocity = Vector3.zero
        curHum:ChangeState(Enum.HumanoidStateType.Running)

        if progress >= 1 then
            isTravelling = false
            stepConnection:Disconnect()
        end
    end)

    repeat task.wait() until progress >= 1 or not isTravelling

    -- Final Landing Snap
    local finalHum, finalHrp, _ = getCharacterComponents()
    if finalHrp and finalHum then
        finalHrp.CFrame = targetCFrame
        finalHrp.AssemblyLinearVelocity = Vector3.zero
        finalHum:ChangeState(Enum.HumanoidStateType.Landed)
    end

    print(string.format("[FastTeleport] Arrived at coordinates: (%.0f, %.0f, %.0f)", targetPos.X, targetPos.Y, targetPos.Z))
    return true
end

-- Export global reference
getgenv().FastTravelAPI = FastTravelAPI

return FastTravelAPI
